package com.java.online_ticket_booking;

import java.sql.Connection;
import java.sql.Date;
import java.sql.PreparedStatement;
import java.sql.SQLException;
import java.sql.Time;
import java.util.Calendar;

public class Booking_details {
	public static int bookticket(int n,int i ) {
		try {
			int s=n*i;
			Connection con=DBConnection.getConnection();
			PreparedStatement ps = con.prepareStatement("insert into bookticket values(?,?,?,?,?)");
			ps.setInt(1,0);
			Time currentTime = new Time(Calendar.getInstance().getTimeInMillis());
			ps.setTime(2, currentTime);
			Date currentDate = new Date(Calendar.getInstance().getTimeInMillis());
			ps.setDate(3, currentDate);
			ps.setInt(4, i);
			ps.setInt(5, s);
			int rows = ps.executeUpdate();
			System.out.println("number of rows affected"+rows);
		} catch (SQLException e) {
			e.printStackTrace();
		}
		return n;
	}

}
